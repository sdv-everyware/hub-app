// hub_app: a smart home hub screen on harry, written against the EveryWare UI library
// (vendor/sdv-everyware/ui-lib) only: the screen's design is design/hub-patch.js
// (+ ui-lib's dark-theme-patch.js), its .dcf made by fig-to-dcf.sh; the house's weather and news come from
// the dashboard bundle on 127.0.0.1:7100, as for smarthome_app (one of the two runs at a time).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "hub_app",
    crate_root: "src/main.rs",
    srcs: [
        "data/*.otf",
    ],
    rustlibs: [
        "libclap",
        "libcustomizations",
        "libhar_log",
        "libhar_monitoring",
        "libhar_platform_api",
        "libhar_types",
        "libhar_user_input_evdev",
        "libharry",
        "libharry_app_platform_specific",
        "libharry_app_utils",
        "liblibc",
        "liblog_rust",
        "libeveryware_ui",
        "libgrpcio",
        "libfutures",
        "libprotobuf",
        "libeveryware_dashboard_grpc",
    ],
    proc_macros: [
        "libclap_derive",
        "libderive_customizations",
        "libhar_ui_model_derive",
    ],
    vendor_available: true,
    min_sdk_version: "29",
    prefer_rlib: true,
    ld_flags: ["-Wl,--no-as-needed"],
    shared_libs: [
        "libEGL",
        "libGLESv2",
    ],
    arch: {
        riscv64: {
            enabled: false,
        },
    },
}
